# ============================================
# PhishShield — Variables de Entorno
# ============================================
# Copia este archivo como .env y completa tus keys
# cp .env.example .env

# ---------------------------
# VirusTotal API (gratuita)
# Registro: https://www.virustotal.com/gui/join-us
# Tu key: https://www.virustotal.com/gui/my-apikey
# Límite gratuito: 500 req/día, 4 req/min
# ---------------------------
VIRUSTOTAL_API_KEY=TU_API_KEY_AQUI

# ---------------------------
# Google Safe Browsing API (gratuita)
# Consola: https://console.cloud.google.com
# Habilitar: "Safe Browsing API" → Crear credencial API Key
# Límite gratuito: 10,000 req/día
# ---------------------------
GOOGLE_SAFE_BROWSING_API_KEY=TU_API_KEY_AQUI

# ---------------------------
# Puerto del servidor (opcional, default: 3000)
# ---------------------------
PORT=3000
